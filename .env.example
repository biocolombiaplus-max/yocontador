# Cadena de conexion a una base de datos PostgreSQL.
# Para desarrollo local puedes usar tu propio Postgres, o un servicio
# gratuito como Neon (https://neon.tech) o Vercel Postgres.
DATABASE_URL="postgresql://usuario:clave@host:5432/nombre_basedatos"

# Genera uno propio por entorno, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="reemplaza-esto-por-un-valor-aleatorio-y-secreto"

# --- Correo (recordatorios y confirmaciones de pago) ---
# Cuenta de Gmail que envia los correos. Usa una "contrasena de aplicacion"
# (no la contrasena normal de la cuenta): actívala en
# https://myaccount.google.com/apppasswords (requiere verificacion en 2 pasos).
EMAIL_USER="tu-cuenta@gmail.com"
EMAIL_APP_PASSWORD="contrasena-de-aplicacion-de-16-caracteres"
EMAIL_FROM_NAME="Bio Marketing"

# --- WhatsApp (enlaces click-to-chat, sin API de pago) ---
# Numero de soporte al que llegan los clientes cuando hacen clic en los
# botones de WhatsApp de los correos y la landing. Formato: codigo pais + numero.
SUPPORT_WHATSAPP="573001234567"

# --- Wompi (pasarela de pagos) ---
# Se consiguen en https://comercios.wompi.co (o el sandbox para pruebas).
# NUNCA compartas la llave privada; solo va en variables de entorno.
WOMPI_PUBLIC_KEY="pub_prod_xxxxxxxx"
WOMPI_PRIVATE_KEY="prv_prod_xxxxxxxx"
# Descomenta para usar el entorno de pruebas de Wompi en vez de produccion:
# WOMPI_SANDBOX="true"

# --- Cron (recordatorios y conciliacion de pagos automaticos) ---
# Cualquier texto largo y aleatorio. Se usa para autorizar las llamadas
# externas a /api/cron/reminders y /api/cron/wompi-sync.
CRON_SECRET="reemplaza-esto-por-otro-valor-aleatorio-y-secreto"
