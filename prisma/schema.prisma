// BIO COLOMBIA - Panel administrativo de grupo empresarial
// Modelo de datos para gestion multiempresa + redes sociales + estadisticas

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PROPIETARIO
  ADMINISTRADORA
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  WHATSAPP
  TIKTOK
}

enum SocialAccountStatus {
  CONECTADA
  PENDIENTE
  DESCONECTADA
}

enum ContentMediaType {
  IMAGEN
  VIDEO
  REEL
  CARRUSEL
}

enum ContentStatus {
  BORRADOR
  PROGRAMADO
  PUBLICADO
  FALLIDO
}

enum ExpenseCategory {
  NOMINA
  ARRIENDO
  SERVICIOS
  MARKETING
  INSUMOS
  TECNOLOGIA
  IMPUESTOS
  OTRO
}

enum BillingPeriod {
  MENSUAL
  ANUAL
}

enum SubscriptionStatus {
  AL_DIA
  PENDIENTE
  SUSPENDIDO
  CANCELADO
}

enum PaymentMethod {
  MANUAL
  WOMPI
  OTRO
}

enum ReminderType {
  RECORDATORIO
  VENCIMIENTO
  SUSPENSION
  CONFIRMACION_PAGO
}

enum ReminderChannel {
  EMAIL
  WHATSAPP
}

model User {
  id                 String   @id @default(cuid())
  cedula             String   @unique
  name               String
  role               UserRole
  passwordHash       String
  mustChangePassword Boolean  @default(true)
  avatarColor        String   @default("#0EA5A4")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  contentPosts ContentPost[]
  activityLogs ActivityLog[]
  incomes      Income[]
  expenses     Expense[]
  payments     Payment[]
}

model Company {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  sector      String
  description String
  colorHex    String   @default("#0EA5A4")
  logoUrl     String?
  website     String?
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  socialAccounts SocialAccount[]
  contentPosts   ContentPost[]
  statSnapshots  StatSnapshot[]
  activityLogs   ActivityLog[]
  incomes        Income[]
  expenses       Expense[]
}

model Income {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  date        DateTime
  amount      Int
  description String
  client      String?
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([companyId, date])
}

model Expense {
  id          String          @id @default(cuid())
  companyId   String
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  date        DateTime
  amount      Int
  category    ExpenseCategory
  description String
  createdById String?
  createdBy   User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())

  @@index([companyId, date])
}

model SocialAccount {
  id          String              @id @default(cuid())
  companyId   String
  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  platform    SocialPlatform
  handle      String
  displayName String?
  status      SocialAccountStatus @default(PENDIENTE)
  followers   Int                 @default(0)
  profileUrl  String?
  accessToken String?
  notes       String?
  connectedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  contentPosts ContentPostTarget[]

  @@unique([companyId, platform])
}

model ContentPost {
  id          String           @id @default(cuid())
  companyId   String
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title       String
  caption     String
  mediaType   ContentMediaType
  mediaUrl    String?
  status      ContentStatus    @default(BORRADOR)
  scheduledAt DateTime?
  publishedAt DateTime?
  createdById String?
  createdBy   User?            @relation(fields: [createdById], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  targets ContentPostTarget[]
}

model ContentPostTarget {
  id              String        @id @default(cuid())
  contentPostId   String
  contentPost     ContentPost   @relation(fields: [contentPostId], references: [id], onDelete: Cascade)
  socialAccountId String
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([contentPostId, socialAccountId])
}

model StatSnapshot {
  id             String         @id @default(cuid())
  companyId      String
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  platform       SocialPlatform
  date           DateTime
  followers      Int            @default(0)
  engagementRate Float          @default(0)
  reach          Int            @default(0)
  postsCount     Int            @default(0)
  createdAt      DateTime       @default(now())

  @@unique([companyId, platform, date])
}

model ActivityLog {
  id        String   @id @default(cuid())
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  detail    String?
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// CRM de clientes: catalogo de servicios que se venden, clientes, sus
// suscripciones a esos servicios, pagos y el historial de recordatorios
// enviados por correo/WhatsApp.
// ---------------------------------------------------------------------------

model ServiceOffering {
  id                 String        @id @default(cuid())
  name               String
  slug               String        @unique
  shortDescription   String
  description        String
  logoUrl            String?
  heroImageUrl       String?
  colorHex           String        @default("#7C3AED")
  defaultPriceCOP    Int
  defaultPeriod      BillingPeriod @default(MENSUAL)
  reconnectionFeeCOP Int           @default(50000)
  isFeatured         Boolean       @default(false)
  isActive           Boolean       @default(true)
  isPublished        Boolean       @default(true)
  order              Int           @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  subscriptions ClientSubscription[]
}

model Client {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  email       String   @unique
  phone       String
  companyName String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions ClientSubscription[]
}

model ClientSubscription {
  id                 String             @id @default(cuid())
  clientId           String
  client             Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  serviceId          String
  service            ServiceOffering    @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  priceCOP           Int
  period             BillingPeriod      @default(MENSUAL)
  status             SubscriptionStatus @default(AL_DIA)
  initialChargeDate  DateTime
  renewalDate        DateTime
  reconnectionFeeCOP Int                @default(50000)
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  payments  Payment[]
  reminders ReminderLog[]

  @@index([status, renewalDate])
}

model Payment {
  id             String             @id @default(cuid())
  subscriptionId String
  subscription   ClientSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  amount         Int
  method         PaymentMethod      @default(MANUAL)
  reference      String?
  paidAt         DateTime           @default(now())
  registeredById String?
  registeredBy   User?              @relation(fields: [registeredById], references: [id], onDelete: SetNull)
  createdAt      DateTime           @default(now())
}

model ReminderLog {
  id             String             @id @default(cuid())
  subscriptionId String
  subscription   ClientSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  type           ReminderType
  channel        ReminderChannel
  daysOffset     Int
  dateKey        String
  sentAt         DateTime           @default(now())

  @@unique([subscriptionId, type, channel, dateKey])
}
